			<EnumInfo>
				<Text><![CDATA[FastReaction]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Execution order: Commands - Exec - Output. Processes new commands before output update, providing the fastest reaction to new commands.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Stable]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[Execution order: Output - Commands - Exec. Output update is executed first, then new commands are processed, providing less jitter for output update.]]></Comment>
			</EnumInfo>
			<Properties>
