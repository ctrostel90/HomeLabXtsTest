    <Property Name="PwmChannel2" Id="{8fdb8e9d-9d17-4fa7-9e06-dcadaa0e745f}" FolderPath="Properties\ProcessImage\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PwmChannel2 : LREAL]]></Declaration>
      <Get Name="Get" Id="{1e641a4f-247a-415c-b47f-a311d68fdc7b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[PwmChannel2	:= 100.0/255*_stNctProcessDataOut.AppData3;]]></ST>
