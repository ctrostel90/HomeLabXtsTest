    <Property Name="PwmChannel1" Id="{eab18e23-5151-476e-a526-560069b21980}" FolderPath="Properties\ProcessImage\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PwmChannel1 : LREAL]]></Declaration>
      <Get Name="Get" Id="{cde40334-5dd7-4b84-a06a-3067b679bd15}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[PwmChannel1	:= 100.0/255*_stNctProcessDataOut.AppData2;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{849da0df-dbd6-4035-8359-d2f46ea9bf9c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_stNctProcessDataOut.AppData2	:= LREAL_TO_USINT(255.0/100*PwmChannel1);]]></ST>
