    <Method Name="GetInput" Id="{5587a1ba-dcd9-490e-ba80-a512760316fd}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD INTERNAL GetInput : LREAL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _BaseUnit = 0 THEN
	RETURN;
END_IF

CASE _ChannelId OF
	1:
		GetInput := _BaseUnit.AnalogInput1;

	2:
		GetInput := _BaseUnit.AnalogInput2;
END_CASE]]></ST>
      </Implementation>
    </Method>
