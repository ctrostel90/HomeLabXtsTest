<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="XtsNctMover" Id="{361a8abc-66b6-4b4e-9fdd-fc5a74404093}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK XtsNctMover EXTENDS XtsMover IMPLEMENTS I_XtsNctMover
VAR
	_NctTask : XtsMoverNctTask;
	_NctTool : I_XtsNctTool;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{406517e2-0f46-4693-9585-eae7e9d931b1}">
      <Declaration><![CDATA[(*FB_Init is always available implicitly and it is used primarily for initialization.
The return value is not evaluated. For a specific influence, you can also declare the
methods explicitly and provide additional code there with the standard initialization
code. You can evaluate the return value.*)
METHOD FB_Init : BOOL
VAR_INPUT
	(* TRUE: the retain variables are initialized (reset warm / reset cold)*)
	bInitRetains : BOOL;

	(* TRUE: the instance will be copied to the copy code afterward (online change)   *)
	bInCopyCode : BOOL;
	Name		: XtsCore.Core.T_MaxString;
	MoverData	: I_XtsMoverData;	  //Optional MoverData assignment
	System		: I_ContainXtsMovers; //Optional Self Registration with an Xts System
	NctTool		: I_XtsNctTool;		  //Optional Nct Tool assignment
END_VAR

VAR
	_Xts : I_XtsSystem;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF __QUERYINTERFACE(System, _Xts) THEN
	_NctTask.XtsSystem := _Xts;
END_IF

_MoverTaskCollection.AddTask(_NctTask);

IF NctTool <> 0 THEN
	_NctTool := NctTool;	
	_NctTool.NctBaseUnit := _NctTask.Nct;
END_IF
 ]]></ST>
      </Implementation>
    </Method>
    <Property Name="Nct" Id="{93ec728e-3bc4-4852-9ad1-1cdacb1d5f8e}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Nct : I_XtsNctBaseUnit]]></Declaration>
      <Get Name="Get" Id="{cfada41e-e384-48dc-b94c-abdba5d22204}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Nct := _NctTask.Nct;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{4e43e18c-5118-456e-ba33-99f90475346c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_NctTask.Nct := Nct;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="NctReady" Id="{dfb3e380-7118-40e4-8d1c-f86d0c067bfb}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NctReady : BOOL]]></Declaration>
      <Get Name="Get" Id="{ed933c79-3f10-4e97-8d12-2b31831f4660}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[NctReady := _NctTask.NctReady;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NctTool" Id="{10432d13-8be1-432b-9423-1ec35a1f27b3}">
      <Declaration><![CDATA[PROPERTY NctTool : I_XtsNctTool]]></Declaration>
      <Get Name="Get" Id="{7063d6f9-7703-4808-9a80-578d0e1da66d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[NctTool := _NctTool;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{0bc32cc0-9ffd-4927-aceb-51214750c5bf}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_NctTool := NctTool;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>